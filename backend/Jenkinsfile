
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR       = 'backend'
        ENV_CREDENTIAL = 'backend-env'

        IMAGE_NAME    = 'dealer-backend:latest'
        CONTAINER_NAME = 'dealer-backend'
        HEALTH_URL    = 'http://127.0.0.1:8000/openapi.json'

        OLLAMA_URL    = 'http://127.0.0.1:11434'
        OLLAMA_MODEL  = 'qwen2.5-coder:3b'
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    deleteDir()

                    writeFile(
                        file: 'pipeline.log',
                        text: "Jenkins pipeline started: ${env.BUILD_TAG}\n"
                    )

                    writeFile(
                        file: 'failure.log',
                        text: ''
                    )

                    try {
                        checkout scm
                    } catch (err) {
                        def message = """
========== FIRST FAILED COMMAND ==========
STAGE: Checkout
COMMAND: checkout scm
ERROR: ${err.getMessage()}
==========================================
"""
                        writeFile(
                            file: 'failure.log',
                            text: message
                        )

                        sh """
                            printf '%s\\n' '${message.replace("'", "'\\''")}' >> pipeline.log
                        """

                        throw err
                    }
                }

                sh '''#!/bin/bash
                    set -e

                    echo "========== CHECKOUT ==========" | tee -a "$WORKSPACE/pipeline.log"
                    echo "Build: $BUILD_NUMBER" | tee -a "$WORKSPACE/pipeline.log"
                    echo "Workspace: $WORKSPACE" | tee -a "$WORKSPACE/pipeline.log"

                    echo "========== REPOSITORY ROOT ==========" | tee -a "$WORKSPACE/pipeline.log"
                    ls -la "$WORKSPACE" | tee -a "$WORKSPACE/pipeline.log"

                    echo "========== APPLICATION DIRECTORY ==========" | tee -a "$WORKSPACE/pipeline.log"
                    ls -la "$WORKSPACE/backend" | tee -a "$WORKSPACE/pipeline.log"
                '''
            }
        }

        stage('Validate Source Code') {
            steps {
                sh '''#!/bin/bash
                    set -e

                    LOG="$WORKSPACE/pipeline.log"
                    FAILURE="$WORKSPACE/failure.log"

                    echo "========== SOURCE VALIDATION ==========" | tee -a "$LOG"

                    record_failure() {
                        local message="$1"

                        {
                            echo "========== FIRST FAILED COMMAND =========="
                            echo "STAGE: Source validation"
                            echo "COMMAND: Source file validation"
                            echo "ERROR: $message"
                            echo "=========================================="
                        } | tee -a "$LOG" "$FAILURE"

                        exit 1
                    }

                    cd "$WORKSPACE"

                    for file in \
                        backend/Jenkinsfile \
                        backend/Dockerfile \
                        backend/docker-compose.yml \
                        backend/requirements.txt
                    do
                        if [ -f "$file" ]; then
                            echo "FOUND: $file" | tee -a "$LOG"
                        else
                            record_failure "Required file missing: $file"
                        fi
                    done

                    if [ -f backend/.dockerignore ]; then
                        echo "FOUND: backend/.dockerignore" | tee -a "$LOG"
                    else
                        echo "WARNING: backend/.dockerignore missing." | tee -a "$LOG"
                    fi

                    echo "Source validation passed." | tee -a "$LOG"
                '''
            }
        }

        stage('Prepare Environment') {
            steps {
                script {
                    try {
                        withCredentials([
                            file(
                                credentialsId: "${ENV_CREDENTIAL}",
                                variable: 'ENV_FILE'
                            )
                        ]) {
                            sh '''#!/bin/bash
                                set -e

                                LOG="$WORKSPACE/pipeline.log"
                                FAILURE="$WORKSPACE/failure.log"

                                echo "========== PREPARING ENVIRONMENT ==========" | tee -a "$LOG"

                                if ! cp "$ENV_FILE" "$WORKSPACE/backend/.env"; then
                                    {
                                        echo "========== FIRST FAILED COMMAND =========="
                                        echo "STAGE: Prepare Environment"
                                        echo "COMMAND: Copy Jenkins environment credential"
                                        echo "ERROR: Failed to copy environment file"
                                        echo "=========================================="
                                    } | tee -a "$LOG" "$FAILURE"

                                    exit 1
                                fi

                                chmod 600 "$WORKSPACE/backend/.env"

                                echo "Environment file installed successfully." | tee -a "$LOG"
                                echo "Environment values are not printed." | tee -a "$LOG"
                            '''
                        }
                    } catch (err) {
                        if (!fileExists('failure.log') ||
                            readFile('failure.log').trim().isEmpty()) {

                            writeFile(
                                file: 'failure.log',
                                text: """
========== FIRST FAILED COMMAND ==========
STAGE: Prepare Environment
COMMAND: Retrieve Jenkins environment credential
ERROR: ${err.getMessage()}
==========================================
"""
                            )
                        }

                        throw err
                    }
                }
            }
        }

        stage('Build Deploy and Verify') {
            steps {
                dir('backend') {
                    sh '''#!/bin/bash
                        set -Eeuo pipefail

                        LOG="$WORKSPACE/pipeline.log"
                        FAILURE="$WORKSPACE/failure.log"

                        echo "========== DOCKER ENVIRONMENT ==========" | tee -a "$LOG"

                        # ------------------------------------------------
                        # Capture every command.
                        # Only the FIRST failed command goes into
                        # failure.log. Later diagnostics go to pipeline.log.
                        # ------------------------------------------------

                        run_logged() {
                            local label="$1"
                            shift

                            local output_file
                            output_file="$(mktemp)"

                            {
                                echo ""
                                echo "=========================================="
                                echo "STAGE COMMAND: $label"
                                echo "COMMAND: $*"
                                echo "TIME: $(date -Is)"
                                echo "=========================================="
                            } | tee -a "$LOG"

                            set +e
                            "$@" 2>&1 | tee "$output_file" | tee -a "$LOG"
                            local command_rc=${PIPESTATUS[0]}
                            set -e

                            if [ "$command_rc" -ne 0 ]; then

                                if [ ! -s "$FAILURE" ]; then
                                    {
                                        echo ""
                                        echo "========== FIRST FAILED COMMAND =========="
                                        echo "COMMAND LABEL: $label"
                                        echo "COMMAND: $*"
                                        echo "EXIT CODE: $command_rc"
                                        echo "TIME: $(date -Is)"
                                        echo "========== ORIGINAL ERROR OUTPUT =========="
                                        cat "$output_file"
                                        echo "=========================================="
                                    } >> "$FAILURE"
                                fi

                                echo "FAILED: $label (exit code $command_rc)" | tee -a "$LOG"

                                rm -f "$output_file"
                                return "$command_rc"
                            fi

                            echo "SUCCESS: $label" | tee -a "$LOG"
                            rm -f "$output_file"
                        }

                        # ------------------------------------------------
                        # Docker availability
                        # ------------------------------------------------

                        run_logged "Docker version" docker --version

                        run_logged "Docker Compose version" docker compose version

                        # ------------------------------------------------
                        # Validate Docker Compose configuration FIRST.
                        # Do not build or start containers if this fails.
                        # ------------------------------------------------

                        run_logged \
                            "Docker Compose configuration validation" \
                            docker compose config -q

                        # ------------------------------------------------
                        # Build image
                        # ------------------------------------------------

                        run_logged \
                            "Docker image build" \
                            docker compose build

                        # ------------------------------------------------
                        # Verify image
                        # ------------------------------------------------

                        run_logged \
                            "Docker image inspection" \
                            docker image inspect "$IMAGE_NAME"

                        # ------------------------------------------------
                        # Python syntax validation
                        # Override the Dockerfile ENTRYPOINT so that
                        # compileall runs as Python, not as application args.
                        # ------------------------------------------------

                        run_logged \
                            "Python syntax validation" \
                            docker compose run \
                                --rm \
                                --no-deps \
                                --entrypoint python \
                                backend \
                                -m compileall -q .

                        # ------------------------------------------------
                        # Deploy
                        # ------------------------------------------------

                        run_logged \
                            "Docker Compose deployment" \
                            docker compose up -d --no-build --force-recreate

                        # ------------------------------------------------
                        # Container status
                        # ------------------------------------------------

                        run_logged \
                            "Docker Compose container status" \
                            docker compose ps -a

                        # ------------------------------------------------
                        # API health check
                        # ------------------------------------------------

                        check_health() {
                            local attempt

                            echo "Checking API: $HEALTH_URL"

                            for attempt in $(seq 1 12); do
                                echo "Health check attempt: $attempt/12"

                                if curl -fsS \
                                    --connect-timeout 5 \
                                    "$HEALTH_URL" \
                                    -o /dev/null; then

                                    echo "API health check successful."
                                    return 0
                                fi

                                sleep 5
                            done

                            echo "API health check failed after 12 attempts."
                            return 1
                        }

                        run_logged "API health check" check_health

                        echo "========== DEPLOYMENT SUCCESSFUL ==========" | tee -a "$LOG"
                    '''
                }
            }
        }
    }

    post {

        failure {
            echo 'Pipeline failed. Running Ollama failure analysis.'

            sh '''#!/bin/bash
                set +e

                LOG="$WORKSPACE/pipeline.log"
                FAILURE="$WORKSPACE/failure.log"

                echo "" | tee -a "$LOG"
                echo "========== OLLAMA FAILURE ANALYSIS ==========" | tee -a "$LOG"

                # ------------------------------------------------
                # Do not overwrite failure.log.
                # Do not use secondary Docker errors as root cause.
                # ------------------------------------------------

                if [ ! -s "$FAILURE" ]; then
                    echo "WARNING: failure.log is empty." | tee -a "$LOG"
                    echo "Jenkins did not record a first failure." | tee -a "$LOG"
                fi

                # ------------------------------------------------
                # Run Ollama using the original failure information.
                # No .env content is read or sent.
                # ------------------------------------------------

                OLLAMA_URL="$OLLAMA_URL" \
                OLLAMA_MODEL="$OLLAMA_MODEL" \
                FAILURE_LOG="$FAILURE" \
                COMPOSE_FILE="$WORKSPACE/backend/docker-compose.yml" \
                DOCKERFILE="$WORKSPACE/backend/Dockerfile" \
                python3 - <<'PY' 2>&1 | tee -a "$LOG"

import os
import json
import urllib.request
import urllib.error

failure_path = os.environ["FAILURE_LOG"]
compose_path = os.environ["COMPOSE_FILE"]
dockerfile_path = os.environ["DOCKERFILE"]

ollama_url = os.environ["OLLAMA_URL"].rstrip("/")
model = os.environ["OLLAMA_MODEL"]

def read_file(path, limit=15000):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as file:
            return file.read()[:limit]
    except Exception as error:
        return "Could not read file: " + str(error)

failure_log = read_file(failure_path)

compose_lines = read_file(compose_path, 10000)
dockerfile_lines = read_file(dockerfile_path, 8000)

# Number the Compose file so Ollama can identify the exact line.
numbered_compose = chr(10).join(
    str(index) + ": " + line
    for index, line in enumerate(compose_lines.splitlines(), 1)
)

prompt = """
You are an expert Jenkins, Docker, Docker Compose, YAML,
Python and DevOps failure-analysis engineer.

Your task is to diagnose the FIRST ACTUAL FAILURE in this Jenkins build.

IMPORTANT RULES:

1. The FIRST FAILED COMMAND recorded in the failure log is authoritative.
2. Read the ORIGINAL ERROR OUTPUT belonging to that command.
3. Do not replace the first failure with a later or secondary error.
4. Do not diagnose a missing container if Compose validation failed
   before container creation.
5. Do not claim docker compose up failed if it was never executed.
6. If Docker Compose reports a YAML parser error, diagnose the YAML
   syntax using the supplied Compose file.
7. Give the exact affected file and line number when possible.
8. Distinguish the actual error from symptoms and consequences.
9. Do not invent commands, files, line numbers or error messages.
10. Never request or reveal environment variable values or secrets.
11. If information is insufficient, explicitly say so.
12. Provide the smallest correction necessary.

FIRST FAILURE LOG:
""" + failure_log + """

NUMBERED DOCKER COMPOSE FILE:
""" + numbered_compose + """

DOCKERFILE:
""" + dockerfile_lines + """

Return your diagnosis in this exact format:

ROOT CAUSE:
FIRST FAILED STAGE:
FIRST FAILED COMMAND:
EXACT ORIGINAL ERROR:
AFFECTED FILE:
LINE/COLUMN:
WHY IT FAILED:
CORRECTED CONFIGURATION OR CODE:
RECOMMENDED FIX:
VERIFICATION COMMAND:
CONFIDENCE:

If the first error is an unterminated YAML quoted scalar,
identify that exact syntax problem. Do not report a missing
container as the root cause.
"""

payload = {
    "model": model,
    "prompt": prompt,
    "stream": False,
    "options": {
        "temperature": 0.1
    }
}

try:
    request = urllib.request.Request(
        ollama_url + "/api/generate",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    with urllib.request.urlopen(request, timeout=180) as response:
        result = json.loads(response.read().decode("utf-8"))

    print()
    print("========== OLLAMA DIAGNOSIS ==========")
    print(result.get("response", "Ollama returned an empty response."))
    print("========== END OLLAMA DIAGNOSIS ==========")

except Exception as error:
    print("Ollama analysis could not be completed.")
    print("Reason:", str(error))
    print("The original Jenkins failure is preserved in failure.log.")

PY

                OLLAMA_RC=${PIPESTATUS[0]}

                if [ "$OLLAMA_RC" -ne 0 ]; then
                    echo "Ollama analysis returned an error." | tee -a "$LOG"
                fi

                echo "========== END OLLAMA FAILURE ANALYSIS ==========" | tee -a "$LOG"

                exit 0
            '''
        }

        cleanup {
            echo 'Cleaning temporary environment files and archiving logs.'

            sh '''#!/bin/bash
                set +e

                rm -f "$WORKSPACE/backend/.env"

                echo "Temporary environment file removed."
            '''

            archiveArtifacts(
                artifacts: 'pipeline.log,failure.log',
                allowEmptyArchive: true,
                fingerprint: true
            )

            echo 'Cleaning Jenkins workspace after log archiving.'
            deleteDir()
        }
    }
}

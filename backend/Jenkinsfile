pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR        = 'backend'
        IMAGE_NAME     = 'dealer-backend'
        CONTAINER_NAME = 'dealer-backend'

        OLLAMA_URL     = 'http://127.0.0.1:11434'
        OLLAMA_MODEL   = 'qwen2.5-coder:3b'

        HEALTH_URL     = 'http://127.0.0.1:8000/openapi.json'

        LOG_FILE       = 'pipeline.log'
        FAILURE_FILE   = 'failure.log'
    }

    stages {

        // =====================================================
        // 1. CHECKOUT SOURCE CODE
        // =====================================================

        stage('Checkout') {
            steps {
                deleteDir()

                script {
                    writeFile file: env.LOG_FILE,
                             text: '===== JENKINS PIPELINE STARTED =====\n'

                    writeFile file: env.FAILURE_FILE,
                             text: '===== CURRENT BUILD COMMAND OUTPUT =====\n'
                }

                checkout scm

                sh '''
                    #!/bin/bash
                    set -euo pipefail

                    LOG="$WORKSPACE/$LOG_FILE"

                    {
                        echo ""
                        echo "========== CHECKOUT INFORMATION =========="
                        echo "Build: $BUILD_NUMBER"
                        echo "Build URL: $BUILD_URL"
                        echo "Workspace: $WORKSPACE"
                        echo "Date: $(date -Is)"
                        echo ""
                        echo "========== REPOSITORY STRUCTURE =========="

                        pwd
                        ls -la

                        echo ""
                        echo "========== BACKEND FILES =========="

                        ls -la "$APP_DIR"

                    } 2>&1 | tee -a "$LOG"
                '''
            }
        }

        // =====================================================
        // 2. VALIDATE REPOSITORY STRUCTURE
        // =====================================================

        stage('Validate Source Code') {
            steps {
                sh '''
                    #!/bin/bash
                    set -euo pipefail

                    LOG="$WORKSPACE/$LOG_FILE"
                    FAILURE="$WORKSPACE/$FAILURE_FILE"

                    echo "===== VALIDATING SOURCE FILES =====" | tee -a "$LOG"

                    REQUIRED_FILES=(
                        "$APP_DIR/Jenkinsfile"
                        "$APP_DIR/Dockerfile"
                        "$APP_DIR/docker-compose.yml"
                        "$APP_DIR/requirements.txt"
                    )

                    for FILE in "${REQUIRED_FILES[@]}"; do

                        if [ ! -f "$FILE" ]; then

                            MESSAGE="ERROR: Required file missing: $FILE"

                            echo "$MESSAGE" | tee -a "$LOG" "$FAILURE"

                            exit 1
                        fi

                        echo "FOUND: $FILE" | tee -a "$LOG"

                    done

                    if [ ! -f "$APP_DIR/server.py" ]; then
                        echo "WARNING: server.py not found. Check your application entry point." \
                            | tee -a "$LOG"
                    fi

                    if [ ! -f "$APP_DIR/.dockerignore" ]; then
                        echo "WARNING: .dockerignore is missing. Make sure .env is excluded from the Docker build context." \
                            | tee -a "$LOG"
                    fi

                    echo "Source file validation successful." | tee -a "$LOG"
                '''
            }
        }

        // =====================================================
        // 3. PREPARE ENVIRONMENT FILE
        // =====================================================

        stage('Prepare Environment') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'backend-env',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    sh '''
                        #!/bin/bash
                        set -euo pipefail

                        LOG="$WORKSPACE/$LOG_FILE"
                        FAILURE="$WORKSPACE/$FAILURE_FILE"

                        echo "===== PREPARING ENVIRONMENT =====" | tee -a "$LOG"

                        if [ ! -f "$ENV_FILE" ]; then

                            echo "ERROR: Jenkins credential backend-env was not found." \
                                | tee -a "$LOG" "$FAILURE"

                            exit 1
                        fi

                        install -m 600 "$ENV_FILE" "$APP_DIR/.env"

                        echo "Environment file installed successfully." | tee -a "$LOG"
                        echo "Environment values are not printed." | tee -a "$LOG"
                    '''
                }
            }
        }

        // =====================================================
        // 4. BUILD, TEST, DEPLOY AND VERIFY
        // =====================================================

        stage('Build Deploy and Verify') {

            steps {
                dir("${APP_DIR}") {

                    sh '''
                        #!/bin/bash
                        set -Eeuo pipefail

                        LOG="$WORKSPACE/$LOG_FILE"
                        FAILURE="$WORKSPACE/$FAILURE_FILE"

                        # ------------------------------------------------
                        # Capture complete command output and exit status
                        # ------------------------------------------------

                        run_logged() {

                            LABEL="$1"
                            shift

                            {
                                echo ""
                                echo "================================================"
                                echo "RUNNING: $LABEL"
                                echo "COMMAND: $*"
                                echo "TIME: $(date -Is)"
                                echo "================================================"
                            } | tee -a "$LOG" "$FAILURE"

                            "$@" 2>&1 | tee -a "$LOG" "$FAILURE"

                            COMMAND_RC=${PIPESTATUS[0]}

                            if [ "$COMMAND_RC" -ne 0 ]; then

                                {
                                    echo ""
                                    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
                                    echo "FIRST FAILED COMMAND: $LABEL"
                                    echo "COMMAND: $*"
                                    echo "EXIT CODE: $COMMAND_RC"
                                    echo "TIME: $(date -Is)"
                                    echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
                                } | tee -a "$LOG" "$FAILURE"

                                return "$COMMAND_RC"
                            fi

                            echo "SUCCESS: $LABEL" | tee -a "$LOG"

                            return 0
                        }

                        # ------------------------------------------------
                        # Docker and Compose availability
                        # ------------------------------------------------

                        echo "===== CHECKING DOCKER ENVIRONMENT =====" | tee -a "$LOG"

                        run_logged "Docker version" docker --version || exit $?

                        run_logged "Docker Compose version" docker compose version || exit $?

                        # ------------------------------------------------
                        # Check environment and Compose files
                        # ------------------------------------------------

                        if [ ! -f .env ]; then

                            echo "ERROR: .env file is missing." | tee -a "$LOG" "$FAILURE"

                            exit 1
                        fi

                        if [ ! -f docker-compose.yml ]; then

                            echo "ERROR: docker-compose.yml is missing." | tee -a "$LOG" "$FAILURE"

                            exit 1
                        fi

                        if [ ! -f Dockerfile ]; then

                            echo "ERROR: Dockerfile is missing." | tee -a "$LOG" "$FAILURE"

                            exit 1
                        fi

                        # ------------------------------------------------
                        # Docker Compose YAML and configuration validation
                        # ------------------------------------------------

                        run_logged \
                            "Docker Compose YAML and configuration validation" \
                            docker compose config -q || exit $?

                        echo "Docker Compose configuration is valid." | tee -a "$LOG"

                        # ------------------------------------------------
                        # Dockerfile and image build
                        # ------------------------------------------------

                        run_logged \
                            "Docker image build" \
                            docker compose build || exit $?

                        # ------------------------------------------------
                        # Verify expected image
                        # ------------------------------------------------

                        run_logged \
                            "Docker image inspection" \
                            docker image inspect "$IMAGE_NAME:latest" || exit $?

                        # ------------------------------------------------
                        # Python syntax validation inside built image
                        # ------------------------------------------------

                        run_logged \
                            "Python application syntax validation" \
                            docker compose run --rm --no-deps backend \
                            python -m compileall -q . || exit $?

                        # ------------------------------------------------
                        # Deploy application
                        # ------------------------------------------------

                        run_logged \
                            "Docker Compose deployment" \
                            docker compose up -d --no-build --force-recreate || exit $?

                        # ------------------------------------------------
                        # Container status
                        # ------------------------------------------------

                        run_logged \
                            "Docker Compose container status" \
                            docker compose ps -a || exit $?

                        # ------------------------------------------------
                        # API health check
                        # ------------------------------------------------

                        echo "" | tee -a "$LOG"
                        echo "===== API HEALTH CHECK =====" | tee -a "$LOG"

                        ATTEMPT=1
                        MAX_ATTEMPTS=12
                        HEALTH_SUCCESS=false

                        while [ "$ATTEMPT" -le "$MAX_ATTEMPTS" ]; do

                            echo "Health check attempt $ATTEMPT/$MAX_ATTEMPTS" \
                                | tee -a "$LOG"

                            if curl \
                                --fail \
                                --silent \
                                --show-error \
                                --max-time 5 \
                                "$HEALTH_URL" \
                                -o /dev/null >> "$LOG" 2>&1; then

                                echo "SUCCESS: API health check passed." | tee -a "$LOG"

                                HEALTH_SUCCESS=true
                                break
                            fi

                            echo "Health check attempt $ATTEMPT failed." \
                                | tee -a "$LOG"

                            ATTEMPT=$((ATTEMPT + 1))

                            sleep 5

                        done

                        if [ "$HEALTH_SUCCESS" != "true" ]; then

                            echo "ERROR: API health check failed: $HEALTH_URL" \
                                | tee -a "$LOG" "$FAILURE"

                            echo "Collecting container diagnostics..." | tee -a "$LOG" "$FAILURE"

                            {
                                echo "========== CONTAINER STATUS =========="
                                docker compose ps -a

                                echo "========== BACKEND CONTAINER LOGS =========="
                                docker compose logs --tail=200 backend

                                echo "========== DIRECT CONTAINER LOGS =========="
                                docker logs --tail=200 "$CONTAINER_NAME"

                            } 2>&1 | tee -a "$LOG" "$FAILURE" || true

                            exit 1
                        fi

                        echo "" | tee -a "$LOG"
                        echo "========== DEPLOYMENT SUCCESSFUL ==========" | tee -a "$LOG"
                        echo "Image: $IMAGE_NAME:latest" | tee -a "$LOG"
                        echo "Container: $CONTAINER_NAME" | tee -a "$LOG"
                        echo "Health URL: $HEALTH_URL" | tee -a "$LOG"

                    '''
                }
            }
        }
    }

    // =========================================================
    // POST BUILD ACTIONS
    // =========================================================

    post {

        success {
            echo 'SUCCESS: Backend built, deployed and health check passed.'
        }

        failure {

            echo 'Pipeline failed. Collecting diagnostics and running Ollama analysis.'

            sh '''
                #!/bin/bash
                set +e

                LOG="$WORKSPACE/$LOG_FILE"
                FAILURE="$WORKSPACE/$FAILURE_FILE"

                touch "$LOG" "$FAILURE"

                {
                    echo ""
                    echo "================================================"
                    echo "POST-FAILURE DIAGNOSTICS"
                    echo "Build: $BUILD_NUMBER"
                    echo "Build URL: $BUILD_URL"
                    echo "Time: $(date -Is)"
                    echo "================================================"

                    if [ -d "$WORKSPACE/$APP_DIR" ]; then

                        cd "$WORKSPACE/$APP_DIR"

                        echo ""
                        echo "========== COMPOSE VALIDATION DIAGNOSTICS =========="

                        if [ -f docker-compose.yml ]; then
                            docker compose config -q 2>&1
                            echo "Diagnostic Compose exit code: $?"
                        fi

                        echo ""
                        echo "========== COMPOSE STATUS =========="

                        docker compose ps -a 2>&1

                        echo ""
                        echo "========== COMPOSE SERVICE LOGS =========="

                        docker compose logs --tail=200 backend 2>&1

                    else

                        echo "Application directory unavailable during post-failure diagnostics."

                    fi

                    echo ""
                    echo "========== DIRECT CONTAINER LOGS =========="

                    docker logs --tail=200 "$CONTAINER_NAME" 2>&1

                    echo ""
                    echo "========== DOCKER IMAGE INFORMATION =========="

                    docker image inspect "$IMAGE_NAME:latest" \
                        --format '{{.Id}} {{.Created}}' 2>&1

                    echo ""
                    echo "========== END POST-FAILURE DIAGNOSTICS =========="

                } >> "$LOG" 2>&1

                # -------------------------------------------------
                # Send original failure log and secondary
                # diagnostics separately to Ollama.
                # -------------------------------------------------

                python3 - "$FAILURE" "$LOG" "$OLLAMA_URL" "$OLLAMA_MODEL" "$BUILD_NUMBER" "$BUILD_URL" <<'PY'

import json
import re
import sys
import urllib.request
from pathlib import Path

failure_path = Path(sys.argv[1])
log_path = Path(sys.argv[2])

ollama_url = sys.argv[3]
model = sys.argv[4]
build_number = sys.argv[5]
build_url = sys.argv[6]


def read_log(path):
    try:
        return path.read_text(errors="replace")
    except Exception as exc:
        return f"Unable to read {path}: {exc}"


def limit_log(value, maximum=30000):
    if len(value) <= maximum:
        return value

    first_part = value[:12000]
    last_part = value[-18000:]

    return (
        first_part
        + "\n\n===== MIDDLE OF LOG OMITTED =====\n\n"
        + last_part
    )


def redact(value):

    # Common password, token and API-key assignments.
    value = re.sub(
        r'(?i)(password|passwd|secret|token|api[_-]?key|access[_-]?key)'
        r'(\s*[=:]\s*|\s+)[^\s,;]+',
        r'\1\2[REDACTED]',
        value
    )

    # Database connection passwords.
    value = re.sub(
        r'(?i)(postgres(?:ql)?://[^:\s]+:)[^@\s]+(@)',
        r'\1[REDACTED]\2',
        value
    )

    # AWS access key IDs.
    value = re.sub(
        r'AKIA[0-9A-Z]{16}',
        '[REDACTED_AWS_ACCESS_KEY]',
        value
    )

    # Common GitHub and SendGrid token formats.
    value = re.sub(
        r'\bgh[pousr]_[A-Za-z0-9_]{20,}\b',
        '[REDACTED_GITHUB_TOKEN]',
        value
    )

    value = re.sub(
        r'\bSG\.[A-Za-z0-9_-]{20,}\b',
        '[REDACTED_SENDGRID_TOKEN]',
        value
    )

    return value


try:

    original_failure = redact(
        limit_log(read_log(failure_path))
    )

    secondary_diagnostics = redact(
        limit_log(read_log(log_path)[-18000:], 18000)
    )

    prompt = f"""
You are a senior DevOps engineer and expert software troubleshooting assistant.

You are analyzing a failed Jenkins pipeline that builds and deploys
a FastAPI application using Docker, Docker Compose and a Dockerfile.

CURRENT BUILD:
{build_number}

BUILD URL:
{build_url}

EXPECTED IMAGE:
dealer-backend:latest

EXPECTED CONTAINER:
dealer-backend

MODEL:
{model}

==================================================
YOUR MAIN OBJECTIVE
==================================================

Find the FIRST REAL FAILURE in the current Jenkins build.

Do not merely summarize the logs.

Identify the exact failing command, error, affected file,
line number when available, root cause and actionable correction.

==================================================
DIAGNOSTIC RULES
==================================================

1. Analyze ORIGINAL FAILURE OUTPUT first.
2. Use secondary diagnostics only to add supporting evidence.
3. Identify the earliest failed command chronologically.
4. Do not mistake post-failure cleanup errors for the root cause.
5. Do not report missing containers or images as the original
   cause if an earlier command prevented their creation.
6. Do not claim a directory is missing unless current evidence
   proves that the required directory is missing.
7. Do not invent filenames, line numbers, commands or log messages.
8. Clearly distinguish proven facts from likely explanations.
9. If there is insufficient evidence, say so explicitly.

==================================================
DOCKERFILE ANALYSIS
==================================================

If Docker build fails:

- Identify the Dockerfile instruction that failed.
- Identify the line number if provided by Docker.
- Explain errors involving FROM, RUN, COPY, ADD, WORKDIR,
  CMD, ENTRYPOINT, EXPOSE, ARG and ENV.
- Check missing files, invalid build contexts, package
  installation failures and dependency errors.
- Show the corrected instruction where evidence supports it.

==================================================
DOCKER COMPOSE ANALYSIS
==================================================

If Docker Compose fails:

- Identify the affected Compose file.
- Inspect the reported YAML line and column.
- Recognize unterminated quotes, indentation errors,
  missing colons, invalid mappings and invalid values.
- Check services, ports, volumes, networks, build contexts,
  Dockerfile paths and environment files.

For example, if the log reports:

while scanning a quoted scalar
found unexpected end of stream
at line 13

Inspect line 13 and surrounding lines.

If the configuration contains:

ports:
  - "8000:

Explain that the quoted scalar is not terminated.

A likely intended correction is:

ports:
  - "8000:8000"

Do not claim that this exact port mapping was intended
unless the source configuration or other evidence confirms it.

==================================================
APPLICATION CODE ANALYSIS
==================================================

If application code fails:

- Identify Python syntax errors and traceback locations.
- Identify missing Python modules and dependencies.
- Identify import errors.
- Identify incorrect application entry points.
- Identify database and Redis connection errors.
- Identify missing environment variables.
- Identify runtime exceptions during FastAPI startup.
- Identify failed API health checks.

Use the actual traceback and container logs as evidence.

==================================================
OUTPUT FORMAT
==================================================

ROOT CAUSE:

FIRST FAILED STAGE:

FIRST FAILED COMMAND:

EXACT ERROR MESSAGE:

AFFECTED FILE:

LINE NUMBER:

WHY IT FAILED:

INCORRECT CONFIGURATION OR CODE:

CORRECTED CONFIGURATION OR CODE:

RECOMMENDED FIX:

VERIFICATION COMMANDS:

CONFIDENCE:
High / Medium / Low

If a section cannot be determined from the logs,
write "Not established by the available logs."

Do not provide generic fixes unrelated to the actual error.

==================================================
ORIGINAL FAILURE OUTPUT
==================================================

{original_failure}

==================================================
SECONDARY DIAGNOSTICS
==================================================

{secondary_diagnostics}
"""

    payload = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0.1,
            "num_ctx": 16384
        }
    }).encode("utf-8")

    request = urllib.request.Request(
        ollama_url.rstrip("/") + "/api/generate",
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    print(
        "\n========== OLLAMA FAILURE ANALYSIS ==========\n",
        flush=True
    )

    with urllib.request.urlopen(request, timeout=300) as response:
        result = json.loads(response.read().decode("utf-8"))

    analysis = result.get("response", "Ollama returned no analysis.")

    print(analysis, flush=True)

    print(
        "\n========== END OLLAMA ANALYSIS ==========\n",
        flush=True
    )

except Exception as exc:

    print(
        f"Ollama analysis failed: {type(exc).__name__}: {exc}",
        flush=True
    )

    print(
        "Check the original Jenkins Console Output and archived failure.log.",
        flush=True
    )

PY
            '''
        }

        always {

            echo 'Cleaning temporary environment files and archiving logs.'

            sh '''
                #!/bin/bash
                set +e

                rm -f "$WORKSPACE/$APP_DIR/.env"
            '''

            archiveArtifacts(
                artifacts: 'pipeline.log,failure.log',
                allowEmptyArchive: true,
                fingerprint: false
            )

            deleteDir()
        }
    }
}

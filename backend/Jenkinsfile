pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR        = 'backend'
        IMAGE_NAME     = 'dealer-backend'
        CONTAINER_NAME = 'dealer-backend'

        OLLAMA_URL     = 'http://127.0.0.1:11434'
        OLLAMA_MODEL   = 'qwen2.5-coder:3b'

        HEALTH_URL     = 'http://127.0.0.1:8000/openapi.json'

        LOG_FILE       = 'pipeline.log'
        FAILURE_FILE   = 'failure.log'
    }

    stages {

        // ==========================================
        // 1. CHECKOUT
        // ==========================================

        stage('Checkout') {
            steps {
                deleteDir()

                script {
                    writeFile file: env.LOG_FILE,
                        text: '===== CURRENT BUILD LOG =====\n'

                    writeFile file: env.FAILURE_FILE,
                        text: '===== ORIGINAL FAILURE OUTPUT =====\n'
                }

                checkout scm

                sh(script: '''#!/bin/bash
set -Eeuo pipefail

LOG="$WORKSPACE/$LOG_FILE"

{
    echo "========== CHECKOUT =========="
    echo "Build: $BUILD_NUMBER"
    echo "Build URL: $BUILD_URL"
    echo "Workspace: $WORKSPACE"
    echo "Time: $(date -Is)"

    echo "========== REPOSITORY ROOT =========="
    pwd
    ls -la

    echo "========== APPLICATION DIRECTORY =========="

    if [ -d "$APP_DIR" ]; then
        ls -la "$APP_DIR"
    else
        echo "ERROR: Application directory not found: $APP_DIR"
    fi

} 2>&1 | tee -a "$LOG"
''')
            }
        }

        // ==========================================
        // 2. VALIDATE SOURCE CODE
        // ==========================================

        stage('Validate Source Code') {
            steps {
                sh(script: '''#!/bin/bash
set -Eeuo pipefail

LOG="$WORKSPACE/$LOG_FILE"
FAILURE="$WORKSPACE/$FAILURE_FILE"

check_file() {
    local file="$1"

    if [ ! -f "$file" ]; then
        echo "ERROR: Required file missing: $file" \
            | tee -a "$LOG" "$FAILURE"
        return 1
    fi

    echo "FOUND: $file" | tee -a "$LOG"
}

echo "========== SOURCE VALIDATION ==========" | tee -a "$LOG"

check_file "$APP_DIR/Jenkinsfile"
check_file "$APP_DIR/Dockerfile"
check_file "$APP_DIR/docker-compose.yml"
check_file "$APP_DIR/requirements.txt"

if [ ! -f "$APP_DIR/server.py" ]; then
    echo "WARNING: server.py not found. Verify your FastAPI entry point." \
        | tee -a "$LOG"
fi

if [ ! -f "$APP_DIR/.dockerignore" ]; then
    echo "WARNING: .dockerignore missing. Ensure .env is excluded from Docker build context." \
        | tee -a "$LOG"
fi

echo "Source validation passed." | tee -a "$LOG"
''')
            }
        }

        // ==========================================
        // 3. PREPARE ENVIRONMENT
        // ==========================================

        stage('Prepare Environment') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'backend-env',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    sh(script: '''#!/bin/bash
set -Eeuo pipefail

LOG="$WORKSPACE/$LOG_FILE"
FAILURE="$WORKSPACE/$FAILURE_FILE"

echo "========== PREPARING ENVIRONMENT ==========" | tee -a "$LOG"

if [ ! -f "$ENV_FILE" ]; then
    echo "ERROR: Jenkins credential backend-env is unavailable." \
        | tee -a "$LOG" "$FAILURE"
    exit 1
fi

install -m 600 "$ENV_FILE" "$WORKSPACE/$APP_DIR/.env"

echo "Environment file installed successfully." | tee -a "$LOG"
echo "Environment values are not printed." | tee -a "$LOG"
''')
                }
            }
        }

        // ==========================================
        // 4. BUILD, DEPLOY AND VERIFY
        // ==========================================

        stage('Build Deploy and Verify') {

            steps {
                dir("${APP_DIR}") {

                    sh(script: '''#!/bin/bash
set -Eeuo pipefail

LOG="$WORKSPACE/$LOG_FILE"
FAILURE="$WORKSPACE/$FAILURE_FILE"

# ------------------------------------------
# LOG COMMAND OUTPUT AND PRESERVE EXIT CODE
# ------------------------------------------

run_logged() {

    local label="$1"
    shift

    {
        echo ""
        echo "=========================================="
        echo "STAGE COMMAND: $label"
        echo "COMMAND: $*"
        echo "TIME: $(date -Is)"
        echo "=========================================="

    } | tee -a "$LOG"

    set +e

    "$@" 2>&1 | tee -a "$LOG" "$FAILURE"

    local command_rc=${PIPESTATUS[0]}

    set -e

    if [ "$command_rc" -ne 0 ]; then

        {
            echo ""
            echo "========== FIRST FAILED COMMAND =========="
            echo "COMMAND LABEL: $label"
            echo "COMMAND: $*"
            echo "EXIT CODE: $command_rc"
            echo "TIME: $(date -Is)"
            echo "=========================================="

        } | tee -a "$LOG" "$FAILURE"

        return "$command_rc"
    fi

    echo "SUCCESS: $label" | tee -a "$LOG"

    return 0
}

# ------------------------------------------
# CHECK DOCKER
# ------------------------------------------

echo "========== DOCKER ENVIRONMENT ==========" | tee -a "$LOG"

run_logged "Docker version" docker --version || exit $?

run_logged "Docker Compose version" docker compose version || exit $?

# ------------------------------------------
# CHECK REQUIRED FILES
# ------------------------------------------

if [ ! -f .env ]; then
    echo "ERROR: .env file is missing." | tee -a "$LOG" "$FAILURE"
    exit 1
fi

if [ ! -f docker-compose.yml ]; then
    echo "ERROR: docker-compose.yml is missing." | tee -a "$LOG" "$FAILURE"
    exit 1
fi

if [ ! -f Dockerfile ]; then
    echo "ERROR: Dockerfile is missing." | tee -a "$LOG" "$FAILURE"
    exit 1
fi

# ------------------------------------------
# DOCKER COMPOSE VALIDATION
# ------------------------------------------

run_logged \
    "Docker Compose configuration validation" \
    docker compose config -q || exit $?

# ------------------------------------------
# DOCKER IMAGE BUILD
# ------------------------------------------

run_logged \
    "Docker image build" \
    docker compose build || exit $?

# ------------------------------------------
# VERIFY IMAGE
# ------------------------------------------

run_logged \
    "Verify built Docker image" \
    docker image inspect "$IMAGE_NAME:latest" || exit $?

# ------------------------------------------
# PYTHON SYNTAX VALIDATION
# ------------------------------------------

run_logged \
    "Python syntax compilation" \
    docker compose run --rm --no-deps backend \
    python -m compileall -q . || exit $?

# ------------------------------------------
# DEPLOY APPLICATION
# ------------------------------------------

run_logged \
    "Docker Compose deployment" \
    docker compose up -d --no-build --force-recreate || exit $?

# ------------------------------------------
# CONTAINER STATUS
# ------------------------------------------

run_logged \
    "Container status" \
    docker compose ps -a || exit $?

# ------------------------------------------
# API HEALTH CHECK
# ------------------------------------------

echo "========== API HEALTH CHECK ==========" | tee -a "$LOG"

attempt=1
max_attempts=12
health_ok=false

while [ "$attempt" -le "$max_attempts" ]; do

    echo "Health check attempt $attempt/$max_attempts" \
        | tee -a "$LOG"

    set +e

    curl \
        --fail \
        --silent \
        --show-error \
        --max-time 5 \
        "$HEALTH_URL" \
        -o /dev/null 2>&1 | tee -a "$LOG" "$FAILURE"

    curl_rc=${PIPESTATUS[0]}

    set -e

    if [ "$curl_rc" -eq 0 ]; then

        health_ok=true

        echo "SUCCESS: API health check passed." | tee -a "$LOG"

        break
    fi

    attempt=$((attempt + 1))

    sleep 5

done

if [ "$health_ok" != "true" ]; then

    echo "ERROR: API health check failed." | tee -a "$LOG" "$FAILURE"

    {
        echo "========== CONTAINER STATUS =========="
        docker compose ps -a

        echo "========== BACKEND SERVICE LOGS =========="
        docker compose logs --tail=200 backend

    } 2>&1 | tee -a "$LOG" "$FAILURE" || true

    exit 1
fi

echo "========== DEPLOYMENT SUCCESSFUL ==========" | tee -a "$LOG"

echo "Image: $IMAGE_NAME:latest" | tee -a "$LOG"
echo "Container: $CONTAINER_NAME" | tee -a "$LOG"
echo "Health URL: $HEALTH_URL" | tee -a "$LOG"

''')
                }
            }
        }
    }

    // ==========================================
    // POST BUILD ACTIONS
    // ==========================================

    post {

        success {
            echo 'SUCCESS: Backend deployed and health check passed.'
        }

        failure {

            echo 'Pipeline failed. Running Ollama failure analysis.'

            sh(script: '''#!/bin/bash
set +e

LOG="$WORKSPACE/$LOG_FILE"
FAILURE="$WORKSPACE/$FAILURE_FILE"

touch "$LOG" "$FAILURE"

# ==========================================
# SECONDARY DIAGNOSTICS
# ==========================================

{
    echo ""
    echo "========== POST-FAILURE DIAGNOSTICS =========="

    echo "Build: $BUILD_NUMBER"
    echo "Build URL: $BUILD_URL"
    echo "Time: $(date -Is)"

    if [ -d "$WORKSPACE/$APP_DIR" ]; then

        cd "$WORKSPACE/$APP_DIR"

        if [ -f docker-compose.yml ]; then

            echo ""
            echo "========== COMPOSE REVALIDATION =========="

            docker compose config -q 2>&1

            echo "Compose diagnostic exit code: $?"

            echo ""
            echo "========== COMPOSE STATUS =========="

            docker compose ps -a 2>&1

            echo ""
            echo "========== BACKEND SERVICE LOGS =========="

            docker compose logs --tail=200 backend 2>&1

        fi

    else

        echo "Application directory unavailable during diagnostics."

    fi

    echo ""
    echo "========== DIRECT CONTAINER LOGS =========="

    docker logs --tail=200 "$CONTAINER_NAME" 2>&1

    echo ""
    echo "========== DOCKER IMAGE =========="

    docker image inspect "$IMAGE_NAME:latest" \
        --format '{{.Id}} {{.Created}}' 2>&1

    echo ""
    echo "========== END SECONDARY DIAGNOSTICS =========="

} >> "$LOG" 2>&1

# ==========================================
# OLLAMA FAILURE ANALYSIS
# ==========================================

python3 - "$FAILURE" "$LOG" "$OLLAMA_URL" "$OLLAMA_MODEL" "$BUILD_NUMBER" "$BUILD_URL" <<'PY'

import json
import re
import sys
import urllib.request
from pathlib import Path

failure_path = Path(sys.argv[1])
log_path = Path(sys.argv[2])

ollama_url = sys.argv[3]
model = sys.argv[4]
build_number = sys.argv[5]
build_url = sys.argv[6]


def read_text(path):
    try:
        return path.read_text(errors="replace")
    except Exception as exc:
        return "Could not read log: " + str(exc)


def trim_log(value, maximum=24000):

    if len(value) <= maximum:
        return value

    return (
        value[:9000]
        + chr(10)
        + "[MIDDLE OF LOG OMITTED]"
        + chr(10)
        + value[-15000:]
    )


def redact(value):

    value = re.sub(
        r"(?i)(password|passwd|secret|token|api[_-]?key|access[_-]?key)([ \t]*[=:][ \t]*|[ \t]+)[^ \t,;]+",
        r"\1\2[REDACTED]",
        value
    )

    value = re.sub(
        r"(?i)(postgres(?:ql)?://[^: \t]+:)[^@ \t]+(@)",
        r"\1[REDACTED]\2",
        value
    )

    value = re.sub(
        r"AKIA[0-9A-Z]{16}",
        "[REDACTED_AWS_ACCESS_KEY]",
        value
    )

    value = re.sub(
        r"gh[pousr]_[A-Za-z0-9_]{20,}",
        "[REDACTED_GITHUB_TOKEN]",
        value
    )

    value = re.sub(
        r"SG[.][A-Za-z0-9_-]{20,}",
        "[REDACTED_SENDGRID_TOKEN]",
        value
    )

    return value


try:

    original_failure = redact(
        trim_log(read_text(failure_path))
    )

    secondary = redact(
        trim_log(read_text(log_path)[-16000:], 16000)
    )

    prompt = f"""
You are an expert DevOps troubleshooting engineer.

Analyze Jenkins build {build_number}.

Build URL:
{build_url}

Application: FastAPI
Deployment: Docker Compose
Expected image: dealer-backend:latest
Expected Compose service: backend
Expected container: dealer-backend

================================================
PRIMARY TASK
================================================

Find the FIRST REAL FAILURE in the original command output.

================================================
DIAGNOSTIC RULES
================================================

1. Analyze ORIGINAL FAILURE OUTPUT first.
2. Identify the first failed command.
3. Quote the exact error message.
4. Use secondary diagnostics only as supporting evidence.
5. Do not mistake missing images, containers or directories
   caused by an earlier failure for the root cause.
6. Never invent filenames, line numbers or commands.
7. Give line numbers only when logs provide them.
8. Clearly distinguish facts from assumptions.
9. If evidence is insufficient, say so.

================================================
DOCKER COMPOSE ANALYSIS
================================================

Interpret YAML parser errors and inspect the reported line and column.

Recognize:

- Unterminated quotation marks.
- Invalid YAML indentation.
- Missing colons.
- Invalid mappings.
- Incorrect port mappings.
- Invalid volume configuration.
- Incorrect service names.
- Incorrect build contexts.
- Missing Dockerfiles.
- Environment file errors.
- Network configuration errors.

If the error says:

while scanning a quoted scalar
found unexpected end of stream

Inspect the actual reported line.

If the line contains:

ports:
  - "8000:

Explain that the quotation is not terminated.

A likely correction is:

ports:
  - "8000:8000"

Do not claim this exact value was intended unless evidence confirms it.

================================================
DOCKERFILE ANALYSIS
================================================

Identify the failing Dockerfile instruction.

Diagnose:

- Invalid Dockerfile instructions.
- Missing COPY source files.
- Incorrect build context.
- Base image pull failures.
- Package installation failures.
- Dependency installation failures.
- Build errors.

================================================
PYTHON APPLICATION ANALYSIS
================================================

Identify:

- Python syntax errors.
- Missing Python packages.
- Import errors.
- Incorrect application entry points.
- Database connection failures.
- Redis connection failures.
- Missing environment variables.
- FastAPI startup exceptions.
- API health-check failures.

Use actual tracebacks and container logs.

================================================
OUTPUT FORMAT
================================================

ROOT CAUSE:

FIRST FAILED STAGE:

FIRST FAILED COMMAND:

EXACT ERROR:

AFFECTED FILE:

LINE/COLUMN:

WHY IT FAILED:

CORRECTED CONFIGURATION OR CODE:

RECOMMENDED FIX:

VERIFICATION COMMAND:

CONFIDENCE: High / Medium / Low

If information cannot be established, write:
"Not established by the available logs."

Do not give generic fixes unrelated to the actual error.
Never reproduce passwords, tokens or secrets.

================================================
ORIGINAL FAILURE OUTPUT
================================================

{original_failure}

================================================
SECONDARY DIAGNOSTICS
================================================

{secondary}
"""

    payload = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0.1,
            "num_ctx": 16384
        }
    }).encode("utf-8")

    request = urllib.request.Request(
        ollama_url.rstrip("/") + "/api/generate",
        data=payload,
        headers={
            "Content-Type": "application/json"
        },
        method="POST"
    )

    print(
        chr(10)
        + "========== OLLAMA FAILURE ANALYSIS =========="
        + chr(10),
        flush=True
    )

    with urllib.request.urlopen(request, timeout=300) as response:

        result = json.loads(
            response.read().decode("utf-8")
        )

    print(
        result.get("response", "Ollama returned no analysis."),
        flush=True
    )

    print(
        chr(10)
        + "========== END OLLAMA ANALYSIS =========="
        + chr(10),
        flush=True
    )

except Exception as exc:

    print(
        "Ollama analysis failed: "
        + type(exc).__name__
        + ": "
        + str(exc),
        flush=True
    )

    print(
        "Review pipeline.log and failure.log in archived artifacts.",
        flush=True
    )

PY
''')
        }

        always {

            echo 'Cleaning temporary environment files and archiving logs.'

            sh(script: '''#!/bin/bash
set +e
rm -f "$WORKSPACE/$APP_DIR/.env"
''')

            archiveArtifacts(
                artifacts: 'pipeline.log,failure.log',
                allowEmptyArchive: true,
                fingerprint: false
            )

            deleteDir()
        }
    }
}
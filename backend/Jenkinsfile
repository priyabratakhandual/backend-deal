# ------------------------------------------------------------
# Send request to Ollama
# ------------------------------------------------------------

payload = {
    "model": model,
    "prompt": prompt,
    "stream": False,
    "options": {
        "temperature": 0.1,
        "num_ctx": 16384
    }
}

try:

    print()
    print("========== CONNECTING TO OLLAMA ==========")
    print("Model:", model)

    request = urllib.request.Request(
        ollama_url + "/api/generate",
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    with urllib.request.urlopen(request, timeout=300) as response:

        result = json.loads(
            response.read().decode("utf-8")
        )

    diagnosis = result.get("response", "").strip()

    print()
    print("========== OLLAMA ROOT CAUSE ANALYSIS ==========")

    if diagnosis:
        print(diagnosis)
    else:
        print("Ollama returned an empty response.")

    print()
    print("========== END OLLAMA ANALYSIS ==========")

except urllib.error.HTTPError as error:

    print("Ollama HTTP error:", error.code)

    try:
        print(
            error.read().decode(
                "utf-8",
                errors="replace"
            )[:3000]
        )
    except Exception:
        pass

    print("Original Jenkins failure remains preserved.")

except Exception as error:

    print("Ollama analysis could not be completed.")
    print("Reason:", str(error))
    print("Original Jenkins failure remains preserved.")

PY

                OLLAMA_RC=${PIPESTATUS[0]}

                if [ "$OLLAMA_RC" -ne 0 ]; then
                    echo "Ollama analysis returned an error." | tee -a "$LOG"
                fi

                echo "========== OLLAMA FAILURE ANALYSIS COMPLETED ==========" | tee -a "$LOG"

                exit 0
            '''
        }

        // =====================================================
        // CLEANUP
        // =====================================================

        cleanup {

            echo 'Cleaning temporary environment files and archiving logs.'

            sh '''#!/bin/bash
                set +e

                rm -f "$WORKSPACE/backend/.env"

                echo "Temporary environment file removed."
            '''

            archiveArtifacts(
                artifacts: 'pipeline.log,failure.log,ollama-diagnostics.txt',
                allowEmptyArchive: true,
                fingerprint: true
            )

            echo 'Cleaning Jenkins workspace after log archiving.'

            deleteDir()
        }
    }
}
